{
  "rules": {
    // Super-admin (Felipe / 77 IS) tem acesso total a tudo, em cascata -
    // simplifica todas as regras abaixo em vez de repetir a condicao em
    // cada no.
    ".read": "auth != null && root.child('superadmins').child(auth.uid).exists()",
    ".write": "auth != null && root.child('superadmins').child(auth.uid).exists()",

    "superadmins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "clientes": {
      // CRM interno da 77 IS - so o super-admin le/escreve (herda da raiz).
      // O cardapio publico nao le mais isso direto; usa $negocio/bloqueio,
      // um espelho reduzido mantido pelo painel_clientes.html.
    },

    "$negocio": {
      // Painel admin (admin_*.html) le o no inteiro de uma vez apos o login -
      // so o dono autenticado deste negocio especifico ganha isso; visitante
      // anonimo continua so com os sub-nos explicitamente liberados abaixo.
      ".read": "auth != null && root.child('admins').child(auth.uid).child('dbKey').val() === $negocio",

      "produtos": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).child('dbKey').val() === $negocio"
      },

      "dados": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).child('dbKey').val() === $negocio"
      },

      "ordem": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).child('dbKey').val() === $negocio"
      },

      "pedidos": {
        // Sem leitura publica da colecao inteira (expunha nome+mesa de todo
        // cliente a qualquer visitante). "Meus Pedidos" agora le pedido por
        // pedido, so os IDs que o proprio navegador guardou apos criar.
        "$pedidoId": {
          ".read": true,
          ".write": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).child('dbKey').val() === $negocio)"
        }
      },

      "config": {
        "whatsapp": {
          ".read": true
        },
        ".write": "auth != null && root.child('admins').child(auth.uid).child('dbKey').val() === $negocio"
      },

      "bloqueio": {
        // Espelho reduzido (bloqueado/trialAtivo/dataInicio) escrito pelo
        // painel_clientes.html - leitura publica pra pagina do cardapio
        // checar bloqueio sem precisar ler o CRM inteiro. So o super-admin
        // escreve (herda da raiz).
        ".read": true
      }
    }
  }
}
